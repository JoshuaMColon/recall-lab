{
  "name": "recall-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI study assistant that quizzes you on WGU course objectives (starting with D335 Introduction to Programming in Python).",
  "scripts": {
    "pyodide": "node scripts/copy-pyodide.mjs",
    "predev": "npm run pyodide",
    "dev": "vite",
    "prebuild": "npm run pyodide",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bank": "python3 scripts/bank/build.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.163",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.159",
    "lucide-react": "^1.65.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^29.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
